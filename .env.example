PORT=4173
# Premium account/auth configuration — set in deployment secrets, never in browser code
ADMIN_EMAIL=stanley.okonkwo282@gmail.com
ADMIN_PASSWORD=replace-with-a-new-long-password
PREMIUM_STORE_PATH=.data/premium-store.json

# Admin network gate. The hub is published to the open internet through a Tailscale
# Funnel, so /admin is only reachable when the request either comes from this
# machine directly, or arrives over the tunnel with a recognised Tailscale identity.
# List your Tailscale login(s), comma separated. Leave empty to disable the
# identity check (local access only) — never publish the portal without it.
ADMIN_TAILNET_LOGINS=

# Paystack: only the public key may appear in browser configuration.
# Keep PAYSTACK_SECRET_KEY server-side and never commit either value.
PAYSTACK_PUBLIC_KEY=pk_live_replace_in_deployment
PAYSTACK_SECRET_KEY=sk_live_replace_in_deployment

# Optional OpenAI-compatible Bible study assistant provider.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
