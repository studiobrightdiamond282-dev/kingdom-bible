PORT=4173
# Premium account/auth configuration — set in deployment secrets, never in browser code
ADMIN_EMAIL=stanley.okonkwo282@gmail.com
ADMIN_PASSWORD=replace-with-a-new-long-password
PREMIUM_STORE_PATH=.data/premium-store.json

# Admin network gate. The hub is published to the open internet through a Tailscale
# Funnel, so /admin is only reachable when the request either comes from this
# machine directly, or arrives over the tunnel with a recognised Tailscale identity.
# List your Tailscale login(s), comma separated. Leave empty to disable the
# identity check (local access only) — never publish the portal without it.
ADMIN_TAILNET_LOGINS=

# Optional canonical public origin, used only for link previews (og:image, og:url,
# canonical, twitter:image). Social crawlers ignore a RELATIVE og:image, so without
# an absolute one a shared hub link renders with no picture at all.
# Leave empty to derive it from each request's own host — that is already correct
# for the Tailscale Funnel hostname, for localhost and for LAN addresses. Set it
# only if the hub is reached through a different name than it is served on (a custom
# domain or proxy), and remember a stale value here silently breaks previews.
PUBLIC_URL=

# Live ministry hub (Tailscale Funnel) — the ministry PC's always-online address.
# The static Vercel site has no phone-remote/SSE hub, so Ministry Mode shows a
# one-tap "Open Live Ministry Hub" doorway to this URL. Change it here when the
# PC or tailnet name changes. Leave the value below; do NOT point it at Vercel.
LIVE_HUB_URL=https://desktop-dqg29pr.tail876272.ts.net

# Paystack: only the public key may appear in browser configuration.
# Keep PAYSTACK_SECRET_KEY server-side and never commit either value.
PAYSTACK_PUBLIC_KEY=pk_live_replace_in_deployment
PAYSTACK_SECRET_KEY=sk_live_replace_in_deployment

# Optional OpenAI-compatible Bible study assistant provider.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Google Sign-In. This is a PUBLIC web client ID (Google publishes these for browser
# use); it is not a secret and no client secret is used for ID-token sign-in.
GOOGLE_CLIENT_ID=

# Turn Google sign-in OFF if the Google Cloud OAuth consent screen is published as
# "Internal". Internal apps only serve ONE Workspace organisation, so every other
# account — including a personal @gmail.com — is refused on Google's own page with
# "Error 403: org_internal". That page belongs to Google, so the app cannot catch or
# explain it, and the user is stranded. With this off the button is replaced by a short
# note and everyone signs in with email + password, which always works.
# To fix it properly instead: Google Cloud Console -> APIs & Services -> OAuth consent
# screen -> change App type from Internal to External, add your domain under
# "Authorized domains", and add test users. Then leave this as on.
GOOGLE_SIGNIN=on

# Studio voice (Gemini text-to-speech) for the Bible reader. The key stays
# server-side; the browser only ever talks to /api/speak on this hub. Leave
# TTS_API_KEY empty to switch the feature off cleanly (device read-aloud still
# works with no key and no internet). The model name is an environment variable
# on purpose: Google renames TTS models, so never hardcode one in the code.
TTS_API_KEY=
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Fenrir