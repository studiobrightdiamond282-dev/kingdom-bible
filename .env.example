PORT=4173

# Local static host only. Vercel and Netlify serve ./public directly and run
# the presentation API as serverless functions, so PORT is not used there.
#
# Optional: shared presentation state. Set BOTH values to a Vercel KV store or
# an Upstash Redis database to keep the live Scripture payload in sync across
# every server instance and region. Without these the app still works — the
# presenter and audience use localStorage, storage events, and BroadcastChannel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

